# Copy to .env and adjust. Dummy values only; never commit real secrets.
APP_ENV=dev
LOG_LEVEL=INFO
# Host port for the compose Postgres; keep it in sync with the URLs below.
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgresql+psycopg://evidencedesk:evidencedesk@127.0.0.1:5434/evidencedesk
TEST_DATABASE_URL=postgresql+psycopg://evidencedesk:evidencedesk@127.0.0.1:5434/evidencedesk_test
# Signs JWT access tokens. Must be at least 32 characters; generate a real one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-not-a-secret-replace-me-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Local embedding model (downloaded to the Hugging Face cache on first worker run).
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# How long an idle worker waits before polling the jobs table again.
WORKER_POLL_SECONDS=1.0
# Prefix added to search queries for BGE models; set to an empty value to disable.
EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
# Load the embedding model at API startup (slow import, fast first search).
PRELOAD_EMBEDDING_MODEL=true
# Cross-encoder reranker for `rerank: true` searches; loaded on first use unless preloaded.
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
PRELOAD_RERANKER=false
# Answers (/v1/answers) call Groq. Put your real key in .env only; this is a placeholder.
# Without a key the app still runs and /v1/answers returns 503 LLM_UNAVAILABLE.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_COMPLETION_TOKENS=2048
ANSWER_CONTEXT_CHUNKS=5
# Chunk window sizes; worker and search must agree, so change them only here.
CHUNK_MAX_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
# Evaluation runs over the API: dataset directory and the corpus manifest to verify against.
EVAL_DATASETS_DIR=eval/datasets
EVAL_CORPUS_MANIFEST=corpus/manifest.yaml
